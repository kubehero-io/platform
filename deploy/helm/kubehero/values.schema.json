{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KubeHero Helm chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "crds": {
      "type": "object",
      "properties": {
        "install": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "url": {
          "type": "string"
        },
        "demoMode": {
          "type": "string",
          "enum": [
            "auto",
            "false"
          ]
        },
        "storeWait": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "auth": {
          "type": "object",
          "properties": {
            "requireAuth": {
              "type": "boolean"
            },
            "apiKeysSecret": {
              "type": "string"
            },
            "scimTokenSecret": {
              "type": "string"
            },
            "oidc": {
              "type": "object",
              "properties": {
                "issuerURL": {
                  "type": "string"
                },
                "audience": {
                  "type": "string"
                },
                "groupRoles": {
                  "type": "string"
                }
              }
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "alertChannels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z+]+://"
          }
        },
        "pricing": {
          "type": "object",
          "properties": {
            "netEgressUSDPerGB": {
              "type": [
                "string",
                "number"
              ]
            },
            "netCrossZoneUSDPerGB": {
              "type": [
                "string",
                "number"
              ]
            },
            "logUSDPerGB": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "collector": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "logs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rateLimit": {
              "type": "integer",
              "minimum": 1
            },
            "excludeNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "startFrom": {
              "type": "string",
              "enum": [
                "end",
                "start"
              ]
            }
          }
        },
        "ebpf": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "netflow": {
              "type": "boolean"
            },
            "profiler": {
              "type": "boolean"
            },
            "profileHz": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "profiling": {
          "type": "object",
          "properties": {
            "scrape": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            }
          }
        },
        "usageInterval": {
          "type": "string"
        },
        "events": {
          "type": "boolean"
        },
        "hostPaths": {
          "type": "object",
          "properties": {
            "logs": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "cgroup": {
              "type": "string"
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "operator": {
      "type": "object",
      "properties": {
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "advisor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "image": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "secretKey": {
              "type": "string"
            }
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "model": {
          "type": "string"
        }
      }
    },
    "pricingEngine": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "gcpBillingSecret": {
          "type": "string"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "properties": {
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "authMode": {
          "type": "string",
          "enum": [
            "token",
            "demo"
          ]
        }
      }
    },
    "chargeback": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "teamLabel": {
          "type": "string"
        },
        "costCenterLabel": {
          "type": "string"
        },
        "nodepoolLabel": {
          "type": "string"
        },
        "defaultTeam": {
          "type": "string"
        },
        "namespaceToTeam": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scrapeInterval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "extraLabels": {
          "type": "object"
        }
      }
    },
    "grafana": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sidecarLabel": {
          "type": "string"
        },
        "sidecarLabelValue": {
          "type": "string"
        },
        "folder": {
          "type": "string"
        },
        "dashboards": {
          "type": "object",
          "properties": {
            "chargeback": {
              "type": "boolean"
            },
            "fleet": {
              "type": "boolean"
            },
            "gpu": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "embedded": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "properties": {
        "embedded": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "dex": {
          "type": "object"
        }
      }
    },
    "secrets": {
      "type": "object"
    },
    "security": {
      "type": "object",
      "properties": {
        "trivy": {
          "type": "object"
        },
        "tetragon": {
          "type": "object"
        },
        "falco": {
          "type": "object"
        }
      }
    },
    "cloud": {
      "type": "object",
      "properties": {
        "aws": {
          "type": "object"
        },
        "gcp": {
          "type": "object"
        },
        "azure": {
          "type": "object"
        }
      }
    },
    "autoscaler": {
      "type": "object"
    },
    "telemetry": {
      "type": "object"
    },
    "networkPolicies": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "controlPlane": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPU": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "targetMemory": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPU": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "certManager": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "duration": {
          "type": "string"
        },
        "renewBefore": {
          "type": "string"
        },
        "issuerRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "ClusterIssuer",
                "Issuer"
              ]
            },
            "group": {
              "type": "string"
            }
          }
        },
        "certificates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "secretName",
              "dnsNames"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              },
              "dnsNames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "duration": {
                "type": "string"
              },
              "renewBefore": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "priorityClass": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000000
        },
        "preemptionPolicy": {
          "type": "string",
          "enum": [
            "PreemptLowerPriority",
            "Never"
          ]
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "priorityClassName": {
      "type": "string"
    },
    "airgap": {
      "type": "boolean"
    },
    "cluster": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "tokenSecret": {
          "type": "string"
        }
      }
    }
  }
}
