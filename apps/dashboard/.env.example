# ─── KubeHero dashboard · environment ──────────────────────────────────────
#
# Copy to .env.local for local dev. Everything here is read server-side
# only — none of it is ever shipped to the browser.

# Control-plane URL (Connect-RPC). When unset, the dashboard renders demo
# data and the DataSourceBadge in every page header reads "demo".
CONTROL_PLANE_URL=http://127.0.0.1:18080

# Advisor service URL (briefings + the /ask investigation agent). Unset →
# demo briefing / scripted demo investigation.
# ADVISOR_URL=http://127.0.0.1:18081

# Sign-in flow:
#   token  paste a control-plane API key / OIDC ID token; validated with
#          WhoAmI; every RPC then runs AS that user (Helm default)
#   demo   any email, no password — only honoured while CONTROL_PLANE_URL
#          is unset (otherwise the dashboard falls back to token)
# Unset → demo without a control plane, token with one.
# KUBEHERO_DASHBOARD_AUTH=token

# Shared service credentials, used ONLY when no signed-in user token is
# available (demo mode, the login page's open-control-plane probe).
# CONTROL_PLANE_TOKEN=
# ADVISOR_TOKEN=

# Key material for the session cookie (AES-256-GCM + HMAC, derived with
# HKDF). REQUIRED in production — the cookie carries the user's token in
# token mode. Without it the dashboard falls back to a well-known insecure
# dev key and logs a warning. Generate with:
#   openssl rand -hex 32
# KUBEHERO_SESSION_SECRET=
